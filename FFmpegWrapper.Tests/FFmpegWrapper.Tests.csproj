<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefineConstants>LIBS_LINUX</DefineConstants>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
        <PackageReference Include="TUnit" Version="1.73.19" />
        <ProjectReference Include="../FFmpegWrapper/FFmpegWrapper.csproj" />
        
        <Content Include="Resources/**/*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        
        <Compile Include="../Deps/Bindings/FFmpegBindings.Linked/Generated/**/*.cs"
                 LinkBase="FFmpegBindings.Linked"/>
    </ItemGroup>

</Project>
