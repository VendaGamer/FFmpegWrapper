<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>net10.0;net462</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup Condition="$(TargetFramework) == 'net10.0'">
        <PublishAot>true</PublishAot>
        <PublishTrimmed>true</PublishTrimmed>
        <IlcCppLinkerCustomWarningRegularExpression>error LNK\d+</IlcCppLinkerCustomWarningRegularExpression>
    </PropertyGroup>

    <PropertyGroup Condition="$(TargetFramework) == 'net462' AND !$([MSBuild]::IsOSPlatform('Windows'))">
        <RunCommand Condition="$(RunCommand) == ''">mono</RunCommand>
        <RunArguments Condition="$(RunArguments) == ''">&quot;$(TargetPath)&quot; $(StartArguments)</RunArguments>
    </PropertyGroup>

    <ItemGroup Condition="$(_IsPublishing) == 'yes' AND $(TargetFramework) == 'net10.0'">
        <DirectPInvoke Include="__Internal" />
        
        <NativeLibrary Include="./Runtime/$(RuntimeIdentifier)/*.lib" />
        <LinkerArg Include="/FORCE:UNRESOLVED" />

        <LinkerArg Include="strmiids.lib" />
        <LinkerArg Include="mfuuid.lib" />
        <LinkerArg Include="mfplat.lib" />
        <LinkerArg Include="gdi32.lib" />
        <LinkerArg Include="user32.lib" />
        <LinkerArg Include="shlwapi.lib" />
        <LinkerArg Include="ole32.lib" />
        <LinkerArg Include="strmiids.lib" />
        <LinkerArg Include="mfuuid.lib" />
        <LinkerArg Include="mfplat.lib" />
        <LinkerArg Include="vfw32.lib" />
    </ItemGroup>
    
    <ItemGroup>
      <Folder Include="Runtime\win-x64\" />
    </ItemGroup>

</Project>
